# Environment Configuration for Campus Placement Engine
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
DATABASE_URL=sqlite:///./placement_engine.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000
SESSION_COOKIE_NAME=placement_session_id
SESSION_MAX_AGE_SECONDS=86400
ENABLE_LLM_ADAPTER=false
OCR_ENABLED=false
PORT=8000
HOST=127.0.0.1
